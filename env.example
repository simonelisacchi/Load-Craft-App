VITE_SUPABASE_ANON_KEY=incolla-qui-la-chiave-anon-public

# Solo se vuoi il backup su Google Sheets (vedi README, sezione dedicata)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
